{
  "productName": "ASR Studio",
  "version": "0.1.0",
  "identifier": "vn.vmed.asr-studio",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui" },
    "devUrl": "http://localhost:5174",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ASR Studio", "width": 1120, "height": 760, "minWidth": 720, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png"], "macOS": { "minimumSystemVersion": "13.3" } }
}
